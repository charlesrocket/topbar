touch components/.qmlls.ini

shopt -s globstar
watch_file plugin/**/*.cpp
watch_file plugin/**/*.hpp
watch_file plugin/**/*.qml
watch_file ./**/CMakeLists.txt

cmake -B build -G Ninja -DDISTRIBUTOR=direnv
cmake --build build

export QS_CONFIG_PATH="$PWD/components"
export QML2_IMPORT_PATH="$PWD/build/qml"
